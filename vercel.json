{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/testimonials",
      "destination": "/testimonials.html"
    },
    {
      "source": "/writing/listening-room",
      "destination": "/writing/listening-room.html"
    },
    {
      "source": "/writing/sample-explorer",
      "destination": "/writing/sample-explorer.html"
    },
    {
      "source": "/sample-explorer",
      "destination": "https://sample-explorer.vercel.app/sample-explorer"
    },
    {
      "source": "/sample-explorer/:path*",
      "destination": "https://sample-explorer.vercel.app/sample-explorer/:path*"
    },
    {
      "source": "/this-is-fine",
      "destination": "https://this-is-fine-4kel.vercel.app/this-is-fine"
    },
    {
      "source": "/this-is-fine/:path*",
      "destination": "https://this-is-fine-4kel.vercel.app/this-is-fine/:path*"
    },
    {
      "source": "/listening-room",
      "destination": "https://listening-room-blender.vercel.app/listening-room"
    },
    {
      "source": "/listening-room/:path*",
      "destination": "https://listening-room-blender.vercel.app/listening-room/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/testimonials.html",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/writing/listening-room.html",
      "destination": "/writing/listening-room",
      "permanent": true
    },
    {
      "source": "/writing/sample-explorer.html",
      "destination": "/writing/sample-explorer",
      "permanent": true
    }
  ]
}
