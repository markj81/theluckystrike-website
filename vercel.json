{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.scdn.co https://media1.tenor.com; connect-src 'self' https://va.vercel-scripts.com; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/index", "destination": "/index.html" },
    { "source": "/testimonials", "destination": "/testimonials.html" },
    { "source": "/testimonials/", "destination": "/testimonials.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/testimonials.html", "destination": "/testimonials", "permanent": true }
  ]
}
